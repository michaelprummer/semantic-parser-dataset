{
  "scenario": "units",
  "test_case": "ambiguous_value",
  "description": "Both files have temperature = 22.0 with DIFFERENT units: file_a says \u00b0C, file_b says \u00b0F. Tests that the parser preserves the unit string and does NOT infer the unit from the numeric value.",
  "shared_semids": [
    "NAME",
    "POS",
    "POWER",
    "PRESS",
    "STATE",
    "THERM",
    "TYPE",
    "VEL",
    "WEIGHT"
  ],
  "file_a_expected_semids": [
    "NAME",
    "POS",
    "POWER",
    "PRESS",
    "STATE",
    "THERM",
    "TYPE",
    "VEL",
    "WEIGHT"
  ],
  "file_b_expected_semids": [
    "NAME",
    "POS",
    "POWER",
    "PRESS",
    "STATE",
    "THERM",
    "TYPE",
    "VEL",
    "WEIGHT"
  ],
  "a_only_semids": [],
  "b_only_semids": [],
  "a_to_b_expected_survivors": {
    "POS": true,
    "POWER": true,
    "PRESS": true,
    "STATE": true,
    "THERM": true,
    "TYPE": true,
    "VEL": true,
    "WEIGHT": true,
    "NAME": true
  },
  "b_to_a_expected_survivors": {
    "POS": true,
    "POWER": true,
    "PRESS": true,
    "STATE": true,
    "THERM": true,
    "TYPE": true,
    "VEL": true,
    "WEIGHT": true,
    "NAME": true
  },
  "a_to_b_expected_losses": [],
  "b_to_a_expected_losses": [],
  "a_to_b_expected_units": {
    "POS": "m",
    "THERM": "\u00b0C",
    "VEL": "m/s",
    "WEIGHT": "kg",
    "POWER": "W",
    "PRESS": "Pa"
  },
  "b_to_a_expected_units": {
    "POS": "m",
    "THERM": "\u00b0F",
    "VEL": "m/s",
    "WEIGHT": "kg",
    "POWER": "W",
    "PRESS": "Pa"
  },
  "notes": "units test case: 08_units_ambiguous_value"
}
