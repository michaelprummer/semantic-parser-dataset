{
  "scenario": "units",
  "test_case": "mismatch_pair",
  "description": "file_a uses SI, file_b uses imperial. Same six properties, same property names; only the unit system and the numeric values change. Tests that the parser preserves per-file unit assignment rather than assuming a single global system.",
  "shared_semids": [
    "NAME",
    "POS",
    "POWER",
    "PRESS",
    "STATE",
    "THERM",
    "TYPE",
    "VEL",
    "WEIGHT"
  ],
  "file_a_expected_semids": [
    "NAME",
    "POS",
    "POWER",
    "PRESS",
    "STATE",
    "THERM",
    "TYPE",
    "VEL",
    "WEIGHT"
  ],
  "file_b_expected_semids": [
    "NAME",
    "POS",
    "POWER",
    "PRESS",
    "STATE",
    "THERM",
    "TYPE",
    "VEL",
    "WEIGHT"
  ],
  "a_only_semids": [],
  "b_only_semids": [],
  "a_to_b_expected_survivors": {
    "POS": true,
    "POWER": true,
    "PRESS": true,
    "STATE": true,
    "THERM": true,
    "TYPE": true,
    "VEL": true,
    "WEIGHT": true,
    "NAME": true
  },
  "b_to_a_expected_survivors": {
    "POS": true,
    "POWER": true,
    "PRESS": true,
    "STATE": true,
    "THERM": true,
    "TYPE": true,
    "VEL": true,
    "WEIGHT": true,
    "NAME": true
  },
  "a_to_b_expected_losses": [],
  "b_to_a_expected_losses": [],
  "a_to_b_expected_units": {
    "POS": "m",
    "THERM": "\u00b0C",
    "VEL": "m/s",
    "WEIGHT": "kg",
    "POWER": "W",
    "PRESS": "Pa"
  },
  "b_to_a_expected_units": {
    "POS": "ft",
    "THERM": "\u00b0F",
    "VEL": "ft/s",
    "WEIGHT": "lb",
    "POWER": "kW",
    "PRESS": "lbf/in\u00b2"
  },
  "notes": "units test case: 03_units_mismatch_pair"
}
